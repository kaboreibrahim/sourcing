#*/10 * * * * cd C:\Users\LENOVO\Desktop\PROJET\Sourcing && C:\Users\LENOVO\Desktop\PROJET\Sourcing\env\Scripts\python.exe manage.py send_pending_emails >> C:\Users\LENOVO\Desktop\PROJET\Sourcing\var\log\cotations\emails.log

# 3. Envoyer les emails toutes les heures à la 5ème minute
#5 * * * * cd C:\Users\LENOVO\Desktop\PROJET\Sourcing && C:\Users\LENOVO\Desktop\PROJET\Sourcing\env\Scripts\python.exe manage.py send_pending_emails >> C:\Users\LENOVO\Desktop\PROJET\Sourcing\var\log\cotations\emails.log

