# Configuration Crontab pour l'envoi automatique des emails
# ============================================================

# Pour éditer le crontab:
# crontab -e

# Pour voir le crontab actuel:
# crontab -l

# ============================================================
# CONFIGURATION RECOMMANDÉE
# ============================================================

# 1. Envoyer les emails toutes les 5 minutes
*/5 * * * * cd C:\Users\LENOVO\Desktop\PROJET\Sourcing && C:\Users\LENOVO\Desktop\PROJET\Sourcing\env\Scripts\python.exe manage.py send_pending_emails >> C:\var\log\cotations\emails.log 2>&1

